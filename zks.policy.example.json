{
  "version": 1,
  "project": "acme-shop",
  "targets": {
    "vercel-prod": { "provider": "vercel", "projectId": "prj_REPLACE_ME", "teamId": "team_REPLACE_ME", "environments": ["production", "preview"] },
    "ssm-prod": { "provider": "aws-ssm", "region": "us-east-1", "prefix": "/acme-shop/prod/", "roleArn": "arn:aws:iam::123456789012:role/zks-secret-writer" },
    "sm-prod": { "provider": "aws-sm", "region": "us-east-1", "prefix": "acme-shop/prod/", "profile": "acme-prod" },
    "github-prod": { "provider": "github", "repo": "acme/shop", "environment": "production" },
    "railway-prod": { "provider": "railway", "projectId": "REPLACE-ME", "environmentId": "REPLACE-ME", "serviceId": "REPLACE-ME", "tokenType": "project" },
    "supabase-prod": { "provider": "supabase", "projectRef": "abcdefghijklmnopqrst" }
  },
  "variables": {
    "STRIPE_SECRET_KEY": {
      "sensitive": true,
      "description": "Stripe live secret key, kept in 1Password",
      "source": { "kind": "op", "ref": "op://Production/Stripe/secret_key" },
      "targets": ["vercel-prod", "ssm-prod", "sm-prod", "github-prod", "railway-prod", "supabase-prod"]
    },
    "DB_USER": {
      "sensitive": false,
      "value": "acme_app",
      "targets": ["railway-prod"]
    },
    "DB_PASSWORD": {
      "sensitive": true,
      "description": "Database password, generated by zks (rotates on every apply)",
      "source": { "kind": "generate", "format": "password", "length": 40, "symbols": false },
      "targets": ["railway-prod"]
    },
    "DATABASE_URL": {
      "sensitive": true,
      "description": "Built in memory from DB_USER, DB_PASSWORD and the host",
      "source": { "kind": "template", "template": "postgres://${DB_USER}:${DB_PASSWORD:url}@db.acme.internal:5432/shop" },
      "targets": ["vercel-prod", "ssm-prod"]
    },
    "JWT_SIGNING_KEY": {
      "sensitive": true,
      "description": "Ed25519 private key for signing tokens",
      "source": { "kind": "generate", "format": "ed25519-private-key" },
      "targets": ["ssm-prod"]
    },
    "JWT_PUBLIC_KEY": {
      "sensitive": false,
      "description": "Public half of JWT_SIGNING_KEY, derived in the same apply",
      "source": { "kind": "public-key", "of": "JWT_SIGNING_KEY" },
      "targets": ["vercel-prod", "github-prod"]
    },
    "LOG_LEVEL": {
      "sensitive": false,
      "value": "info",
      "targets": ["vercel-prod", "ssm-prod", "github-prod", "railway-prod", "supabase-prod"]
    }
  }
}
